# ==============================================================================
# Smallest AI API Configuration Template (.env.example)
# Copy this file to .env and insert your actual credentials:
#   cp .env.example .env
# ==============================================================================

# Your Smallest AI API key (obtain from https://smallest.ai console)
SMALLEST_API_KEY=your_smallest_api_key_here

# ------------------------------------------------------------------------------
# API Endpoints
# ------------------------------------------------------------------------------
SMALLEST_BASE_URL=https://api.smallest.ai
SMALLEST_TTS_URL=https://api.smallest.ai/waves/v1/tts
SMALLEST_STT_REST_URL=https://api.smallest.ai/waves/v1/stt/
SMALLEST_STT_WS_URL=wss://api.smallest.ai/waves/v1/stt/live

# ------------------------------------------------------------------------------
# Default Model & Synthesis Parameters
# ------------------------------------------------------------------------------
TTS_MODEL=lightning_v3.1_pro
TTS_VOICE_ID=meher
TTS_SAMPLE_RATE=24000
TTS_OUTPUT_FORMAT=wav

# ------------------------------------------------------------------------------
# Speech-to-Text Parameters
# ------------------------------------------------------------------------------
STT_MODEL=pulse
STT_LANGUAGE=en
STT_ENCODING=linear16
STT_SAMPLE_RATE=24000
STT_WORD_TIMESTAMPS=true
